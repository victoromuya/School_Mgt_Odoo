<odoo>
  <data>
    <!-- Tree View -->
    <record model="ir.ui.view" id="student_record_tree">
      <field name="name">student.record.tree</field>
      <field name="model">student.record</field>
      <field name="arch" type="xml">
        <tree string="Student Records">
          <field name="name"/>
          <field name="age"/>
          <field name="active"/>
        </tree>
      </field>
    </record>

    <!-- Form View -->
    <record model="ir.ui.view" id="student_record_form">
      <field name="name">student.record.form</field>
      <field name="model">student.record</field>
      <field name="arch" type="xml">
        <form string="Student Record">
          <sheet>
            <group>
              <field name="name"/>
              <field name="age"/>
              <field name="active"/>
            </group>
          </sheet>
          <footer>
            <button name="deactivate_student" string="Deactivate Student" type="object" class="btn-primary"/>
          </footer>
        </form>
      </field>
    </record>

    <!-- Action for Student Records -->
    <record model="ir.actions.act_window" id="student_record_action">
      <field name="name">Student Records</field>
      <field name="res_model">student.record</field>
      <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu: School (Main Menu) -->
    <menuitem name="School" id="school_menu_root" sequence="10"/>

    <!-- Menu: Students (Sub Menu) -->
    <menuitem name="Students" id="students_menu" parent="school_menu_root" action="student_record_action" sequence="20"/>

    <!-- View Inheritance to hide age field -->
    <record model="ir.ui.view" id="student_record_form_inherit">
      <field name="name">student.record.form.inherit</field>
      <field name="model">student.record</field>
      <field name="inherit_id" ref="student_record_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='age']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
